{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openblueprint.dev/schemas/design.schema.json",
  "title": "OpenBlueprint Design",
  "description": "Canonical machine-readable representation of an OpenBlueprint engineering design.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "requirements",
    "systems",
    "components",
    "connections",
    "constraints",
    "parameters"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique identifier for the design."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable design name."
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the design."
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "validation": {
      "$ref": "#/$defs/validationState"
    },
    "simulation": {
      "$ref": "#/$defs/simulationState"
    },
    "bom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bomItem"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "type": {
          "type": "string",
          "enum": [
            "functional",
            "electrical",
            "mechanical",
            "software",
            "performance",
            "environmental",
            "safety",
            "cost",
            "regulatory",
            "user_defined"
          ]
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "<",
            "<=",
            "=",
            ">=",
            ">",
            "!=",
            "contains",
            "matches",
            null
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "medium"
        }
      }
    },

    "system": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "systemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "componentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "partNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "specifications": {
          "type": "object",
          "additionalProperties": true
        },
        "interfaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operatingLimits": {
          "type": "object",
          "additionalProperties": true
        },
        "physicalProperties": {
          "type": "object",
          "additionalProperties": true
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "datasheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "simulationModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "interface": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional",
            "passive",
            "unknown"
          ]
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "voltage": {
          "type": [
            "number",
            "null"
          ]
        },
        "current": {
          "type": [
            "number",
            "null"
          ]
        },
        "frequency": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "connection": {
      "type": "object",
      "required": [
        "id",
        "source",
        "destination"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "sourceInterfaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "destinationInterfaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "constraint": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expression": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      }
    },

    "parameter": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "default": ""
        }
      }
    },

    "resource": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "capacity": {},
        "usage": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "validationState": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "warnings",
            "failed",
            "unknown"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationResult"
          }
        }
      }
    },

    "validationResult": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "unknown"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "message": {
          "type": "string"
        },
        "affectedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "simulationState": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "queued",
            "running",
            "completed",
            "failed",
            "unsupported"
          ]
        },
        "simulator": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "additionalProperties": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "bomItem": {
      "type": "object",
      "required": [
        "componentId",
        "quantity"
      ],
      "properties": {
        "componentId": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitCost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "totalCost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplier": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycleStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}